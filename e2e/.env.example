# Get a valid API key from: https://ai.google.dev/
# 1. Visit https://ai.google.dev/
# 2. Click "Get API Key" 
# 3. Google will automatically create a project and enable the Generative AI API
# 4. Copy the key and paste below (replacing YOUR_VALID_API_KEY_HERE)
# IMPORTANT: The key must be from Google AI Studio (ai.google.dev) not from Cloud Console alone

GEMINI_API_KEY_TEST=YOUR_VALID_API_KEY_HERE

# Optional: Control healer behavior
HEALER_AUTO_FIX=false                     # Auto-apply fixes (default: false)
HEALER_VERBOSE=false                      # Detailed logging (default: false) 
HEALER_MAX_RETRIES=3

# Optional: Playwright configuration
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOW_MO=0

# Performance Tuning
HEALER_MAX_RETRIES=3                      # Retry attempts on API failure
HEALER_API_TIMEOUT=60000                  # API timeout in ms
HEALER_API_RATE_LIMIT=5                   # Calls per minute
HEALER_MAX_FILE_SIZE=1048576              # Max file size for analysis (1MB)

# Storage
HEALER_BACKUP_DIR=reports/audit/.healer-backups
HEALER_AUDIT_LOG=reports/audit/.healer-audit.log
BACKUP_RETENTION_DAYS=7                   # Keep backups for 7 days
MAX_BACKUPS_PER_FILE=5                    # Keep 5 backups per test file

# ============ SOURCE CODE ANALYSIS CONFIGURATION ============

# Enable/disable source code analysis feature (opt-in for security)
HEALER_SOURCE_CODE_ANALYSIS=true

# Whitelist allowed directories for source code access
HEALER_SOURCE_CODE_WHITELIST=movieapp/frontend/src/components/**

# Security: File size limits
HEALER_SOURCE_CODE_MAX_FILE_SIZE=500000        # 500KB per file
HEALER_SOURCE_CODE_MAX_EXTRACTION_SIZE=2097152 # 2MB per session
MAX_SOURCE_CODE_FILES_PER_SESSION=20           # Max 20 files per run

# Audit & compliance
SOURCE_CODE_ACCESS_AUDIT_LOG=logs/source-code-access-audit.json

# E2E Test Environment Variables
