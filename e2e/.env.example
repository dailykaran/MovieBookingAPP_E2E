# TicketsVenue E2E Test Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real API keys

# ====================================================================
# REQUIRED: Google Generative AI (Gemini API)
# ====================================================================
# Get a FREE API key from: https://ai.google.dev/
# 1. Visit https://ai.google.dev/
# 2. Click "Get API Key"
# 3. Google creates project automatically
# 4. Copy the key and paste below

GEMINI_API_KEY_TEST=AIza_YOUR_API_KEY_HERE

# ====================================================================
# HEALING BEHAVIOR (Optional: Defaults shown)
# ====================================================================

# Auto-apply fixes to test files
# true = auto-fix mode, false = analysis-only (default: false)
HEALER_AUTO_FIX=true

# Enable detailed logging during healing process
# true = verbose output, false = concise output (default: false)
HEALER_VERBOSE=false

# ====================================================================
# PERFORMANCE TUNING (Optional: Defaults shown)
# ====================================================================

# Number of retry attempts on API failure
# Range: 1-5 (default: 3)
HEALER_MAX_RETRIES=3

# API response timeout in milliseconds
# Range: 30000-120000 (default: 60000 = 60 seconds)
HEALER_API_TIMEOUT=60000

# API rate limit (calls per minute) to prevent quota exhaustion
# Range: 1-10 (default: 5)
HEALER_API_RATE_LIMIT=5

# Max file size for analysis in bytes
# Default: 1048576 (1MB)
HEALER_MAX_FILE_SIZE=1048576

# Max log events in memory (prevents unbounded growth)
# Default: 200
HEALER_MAX_LOG_EVENTS=200

# ====================================================================
# STORAGE & BACKUP (Optional: Defaults shown)
# ====================================================================

# Directory for automatic test file backups (relative to e2e/)
# Backups created before applying fixes
HEALER_BACKUP_DIR=reports/audit/.healer-backups

# Audit log file path for all healing operations
HEALER_AUDIT_LOG=reports/audit/.healer-audit.log

# Number of days to keep backups before auto-deletion
# Range: 1-30 (default: 7)
BACKUP_RETENTION_DAYS=7

# Maximum backups to keep per test file
# Older backups auto-deleted (default: 5)
MAX_BACKUPS_PER_FILE=5

# ====================================================================
# SOURCE CODE ANALYSIS (Optional: Defaults shown)
# Disabled by default for security - enable only if needed
# ====================================================================

# Enable/disable source code analysis for UI element extraction
# true = analyze frontend code, false = skip analysis (default: false)
HEALER_SOURCE_CODE_ANALYSIS=false

# Whitelist allowed directories for source code access
# Syntax: path/to/dir/** (comma-separated for multiple)
# Security: Only whitelisted paths are analyzed
HEALER_SOURCE_CODE_WHITELIST=movieapp/frontend/src/components/**

# Max file size for source code analysis in bytes
# Default: 500000 (500KB per file)
HEALER_SOURCE_CODE_MAX_FILE_SIZE=500000

# Max total bytes extracted per session
# Default: 2097152 (2MB per run)
HEALER_SOURCE_CODE_MAX_EXTRACTION_SIZE=2097152

# Max number of source code files analyzed per session
# Default: 20 (prevents resource exhaustion)
MAX_SOURCE_CODE_FILES_PER_SESSION=20

# Audit log for source code access (tracks what files were analyzed)
SOURCE_CODE_ACCESS_AUDIT_LOG=logs/source-code-access-audit.json

# ====================================================================
# PLAYWRIGHT BROWSER CONFIGURATION (Optional: Defaults shown)
# ====================================================================

# Run tests in headless mode (no visible browser)
# true = hidden, false = visible window (default: true for CI)
PLAYWRIGHT_HEADLESS=true

# Slow down browser actions (ms) for debugging
# 0 = no delay, 100+ = visible slowdown for observation (default: 0)
PLAYWRIGHT_SLOW_MO=0

# ====================================================================
# QUICK REFERENCE
# ====================================================================
# Commands:
#   npm test                       Run all E2E tests
#   npm run test:debug             Run with visible browser
#   npm run heal:gemini            Analyze failures (report only)
#   npm run heal:gemini:auto       Auto-fix all failures
#   npm run heal:gemini:verbose    Auto-fix with detailed logs
#
# Report Locations:
#   reports/playwright/index.html  Playwright test report
#   reports/healer/healing-report.html  Healing analysis (newGoogleSDKGenAI)
#   reports/audit/.healer-audit.log  Healing operation log
#
# Troubleshooting:
#   - If API key invalid: Get new from https://ai.google.dev/
#   - If tests timeout: Increase HEALER_API_TIMEOUT
#   - If rate limited: Reduce HEALER_API_RATE_LIMIT or wait 1 minute
#   - For more info: See README.md
