{
  "name": "self-healing-e2e",
  "version": "1.0.0",
  "description": "Self-healing E2E test system powered by Gemini 2.5 Pro + Vertex AI",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "heal:manual": "node src/manual-heal.js",
    "heal:batch": "node src/batch-heal.js",
    "heal:approve": "node src/heal-approver.js",
    "grant-access": "node scripts/grant-full-access.js",
    "revoke-access": "rm -f .healer-permissions.json && echo '✅ Full access revoked'",
    "test": "playwright test",
    "test:debug": "playwright test --debug --headed",
    "audit:review": "node src/audit-viewer.js",
    "validate:env": "node src/validate-env.js",
    "setup:iam": "node setup-gcloud.js",
    "setup:gcloud": "node setup-gcloud.js",
    "diagnose:permissions": "node diagnose-permissions.js"
  },
  "keywords": [
    "playwright",
    "e2e",
    "self-healing",
    "gemini",
    "vertex-ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/aiplatform": "^3.22.0",
    "@google-cloud/vertexai": "^1.7.0",
    "@google/generative-ai": "^0.3.1",
    "@playwright/test": "^1.56.1",
    "adm-zip": "^0.5.16",
    "ajv": "^8.16.0",
    "dotenv": "^17.2.3",
    "fast-redact": "^3.3.0",
    "p-retry": "^6.2.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "googleapis": "^171.4.0",
    "vitest": "^2.0.0"
  }
}
