# Stripe Configuration
# Get your test keys from: https://dashboard.stripe.com/test/apikeys

# Replace with your actual Stripe Publishable Key (starts with pk_test_)
REACT_APP_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Replace with your actual Stripe Client Secret (starts with pi_test_ or cs_test_)
REACT_APP_STRIPE_CLIENT_SECRET=your_stripe_secret_key_here
# Optional: API endpoint (if using a backend)
REACT_APP_API_URL=http://localhost:5000/api
