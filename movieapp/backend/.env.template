# ShowGlow Backend - Environment Configuration Template
# Copy this file to .env and configure for your environment

# 🔒 Server Configuration
PORT=5000
NODE_ENV=development

# 🔒 CORS Configuration - CRITICAL FOR SECURITY
# Specify the frontend URL(s) that are allowed to make requests
FRONTEND_URL=http://localhost:3000
# For production, use comma-separated list:
# FRONTEND_URL=https://yourdomain.com,https://www.yourdomain.com

# 🔒 Database (when migrating from JSON to real database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=showglow
DB_USER=postgres
DB_PASSWORD=change_me_in_production

# 🔒 JWT Configuration (when implementing authentication)
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=7d

# 🔒 SSL/TLS Configuration (production)
SSL_ENABLED=false
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# 🔒 Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100   # Max requests per window

# 🔒 Logging Configuration
LOG_LEVEL=info
LOG_FILE=/var/log/showglow/app.log

# 🔒 Stripe Configuration (when implementing real payments)
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here_keep_secret

# 🔒 Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# 🔒 Session Configuration
SESSION_SECRET=change_me_in_production
SESSION_TIMEOUT=3600000  # 1 hour in milliseconds

# 🔒 Security Headers
HSTS_MAX_AGE=31536000  # 1 year
